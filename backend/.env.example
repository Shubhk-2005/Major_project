PROJECT_NAME="MsAdmit API"
API_V1_STR="/api/v1"
SECRET_KEY="msadmit-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Mode: 'sql' (PostgreSQL / SQLite) or 'mongodb'
DB_ENGINE="sql"
DATABASE_URL="sqlite:///./msadmit.db"

# MongoDB (Ready for local MongoDB or MongoDB Atlas)
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="msadmit"

# Gemini LLM API Key
GEMINI_API_KEY=""

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'
